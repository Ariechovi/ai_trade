# ===================== LLM（DeepSeek） =====================
# 真实调用时填写；不填也能跑（会自动降级为离线桩模型）
DEEPSEEK_API_KEY=*****
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.3

# ===================== 运行参数 =====================
# 数据源：auto / akshare（真实 A 股） | mock（离线模拟数据，输出会带标记）
DATA_PROVIDER=auto
# 多空辩论轮数：0 = 不辩论直接给结论；1 = 各说一轮；2 = 各说两轮
MAX_DEBATE_ROUNDS=2
# 单个 Agent 节点内 ReAct 工具循环的最大迭代次数
MAX_TOOL_ITERATIONS=3
# 节点级容错：可重试错误（限流/超时/连接/5xx）最多尝试几次
MAX_RETRY_ATTEMPTS=3
# 指数退避基数（秒）：第 1 次失败等 0.5s，第 2 次 1s，第 3 次 2s
RETRY_BASE_DELAY=0.5
# 1 = 强制使用离线桩模型（不需要任何 API Key）
OFFLINE=0

# akshare 底层 socket 超时（秒）。设为 0 可关闭（不建议：网络抖动会无限挂起）
# 说明：akshare 用 requests/urllib3，不传 timeout 时会退回 socket 默认值；
#       而 LLM 客户端用 httpx（自带超时），所以这个值不会影响模型调用。
AKSHARE_TIMEOUT=30

# ===================== HTTP API（可选） =====================
# 启动：uvicorn mini_agents.api.app:create_app --factory --port 8100
API_HOST=127.0.0.1
API_PORT=8100
API_KEY=                              # 留空 = 不校验（仅本机开发）
API_CORS_ORIGINS=http://localhost:3100,http://localhost:8501
MAX_CONCURRENT_RUNS=2                 # 同时在跑的分析数
SSE_HEARTBEAT_SECONDS=10
SSE_MAX_IDLE_SECONDS=300
MINI_AGENTS_CACHE_DIR=                # 留空 = LOCALAPPDATA/mini-agents

# ===================== 存储层（PostgreSQL）=====================
# PostgreSQL 是唯一存储。没配就跑不起来 —— 用 docker compose 起一个本地的即可。
PG_HOST=                              # SSH 隧道场景填 127.0.0.1
PG_PORT=15432                         # SSH 隧道场景填**本地转发端口**，不是服务器的 5432
PG_DB=mini_agents
PG_USER=
PG_PASSWORD=
PG_SSLMODE=prefer                     # 走隧道 disable 也行；服务端强制 SSL 时改 require
PG_CONNECT_TIMEOUT=5                  # 远程连接不能无限等
PG_STATEMENT_TIMEOUT_MS=10000         # 单条语句上限，防止一个慢查询拖死应用
PG_POOL_MIN=1
PG_POOL_MAX=4                         # 连接池上限：远程连接是稀缺资源

# SSH 隧道怎么建（在**你本机**执行，不要关掉这个窗口）：
#   ssh -N -L 15432:127.0.0.1:5432 <user>@<your-server>
# 然后上面的 PG_HOST=127.0.0.1 / PG_PORT=15432 就指向隧道。
