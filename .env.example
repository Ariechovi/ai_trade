# ===================== LLM（DeepSeek） =====================
# 真实调用时填写；不填也能跑（会自动降级为离线桩模型）
DEEPSEEK_API_KEY=*****
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.3

# ===================== 运行参数 =====================
# mock（离线确定性数据，默认） | akshare（真实 A 股数据）
DATA_PROVIDER=mock
# 多空辩论轮数：0 = 不辩论直接给结论；1 = 各说一轮；2 = 各说两轮
MAX_DEBATE_ROUNDS=2
# 单个 Agent 节点内 ReAct 工具循环的最大迭代次数
MAX_TOOL_ITERATIONS=3
# 1 = 强制使用离线桩模型（不需要任何 API Key）
OFFLINE=0
