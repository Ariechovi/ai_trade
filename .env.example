# ===================== LLM（DeepSeek） =====================
# 真实调用时填写；不填也能跑（会自动降级为离线桩模型）
DEEPSEEK_API_KEY=*****
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.3

# ===================== 运行参数 =====================
# 数据源：auto / akshare（真实 A 股） | mock（离线模拟数据，输出会带标记）
DATA_PROVIDER=auto
# 多空辩论轮数：0 = 不辩论直接给结论；1 = 各说一轮；2 = 各说两轮
MAX_DEBATE_ROUNDS=2
# 单个 Agent 节点内 ReAct 工具循环的最大迭代次数
MAX_TOOL_ITERATIONS=3
# 节点级容错：可重试错误（限流/超时/连接/5xx）最多尝试几次
MAX_RETRY_ATTEMPTS=3
# 指数退避基数（秒）：第 1 次失败等 0.5s，第 2 次 1s，第 3 次 2s
RETRY_BASE_DELAY=0.5
# 1 = 强制使用离线桩模型（不需要任何 API Key）
OFFLINE=0

# akshare 底层 socket 超时（秒）。设为 0 可关闭（不建议：网络抖动会无限挂起）
# 说明：akshare 用 requests/urllib3，不传 timeout 时会退回 socket 默认值；
#       而 LLM 客户端用 httpx（自带超时），所以这个值不会影响模型调用。
AKSHARE_TIMEOUT=30

# ===================== HTTP API（可选） =====================
# 启动：uvicorn mini_agents.api.app:create_app --factory --port 8100
API_HOST=127.0.0.1
API_PORT=8100
API_KEY=                              # 留空 = 不校验（仅本机开发）
API_CORS_ORIGINS=http://localhost:3100,http://localhost:8501
MAX_CONCURRENT_RUNS=2                 # 同时在跑的分析数
SSE_HEARTBEAT_SECONDS=10
SSE_MAX_IDLE_SECONDS=300
RUN_DB_PATH=                          # 留空 = 用户缓存目录下的 runs.sqlite3
MINI_AGENTS_CACHE_DIR=                # 留空 = LOCALAPPDATA/mini-agents
